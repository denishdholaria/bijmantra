# PostgreSQL with TimescaleDB + PostGIS + pgvector
# For Bijmantra Plant Breeding Platform
#
# Build: podman build -t bijmantra-postgres -f Containerfile .
# Run: podman run -d --name bijmantra-postgres -e POSTGRES_PASSWORD=secret bijmantra-postgres
#
# timescaledb-ha bundles: TimescaleDB, PostGIS, pgvector, pgaudit, pgcrypto, ltree, pg_trgm, uuid-ossp
# No additional apt installs required.

FROM timescale/timescaledb-ha:pg16-all

LABEL maintainer="Bijmantra Team"
LABEL description="PostgreSQL 16 with TimescaleDB, PostGIS, and pgvector for plant breeding AI"
LABEL version="3.0.0"

# Copy initialization script
COPY init-extensions.sql /docker-entrypoint-initdb.d/

# Default environment
ENV POSTGRES_DB=bijmantra_db
ENV POSTGRES_USER=bijmantra_user
